<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="8dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="1dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/ivAvatarHistory"
            android:layout_width="45dp"
            android:layout_height="45dp"
            android:alpha="0.8"
            android:src="@drawable/default_avt"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:shapeAppearanceOverlay="@style/CircleImage" />

        <TextView
            android:id="@+id/tvNameHistory"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="Nguyễn Văn A"
            android:textColor="#555555"
            android:textSize="15sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@+id/tvStatusHistory"
            app:layout_constraintStart_toEndOf="@id/ivAvatarHistory"
            app:layout_constraintTop_toTopOf="@id/ivAvatarHistory" />

        <TextView
            android:id="@+id/tvServiceHistory"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Dọn dẹp nhà cửa"
            android:textColor="#888888"
            android:textSize="13sp"
            app:layout_constraintStart_toStartOf="@id/tvNameHistory"
            app:layout_constraintTop_toBottomOf="@id/tvNameHistory" />

        <TextView
            android:id="@+id/tvStatusHistory"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#F5F5F5"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:text="Hoàn thành"
            android:textColor="#757575"
            android:textSize="11sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <View
            android:id="@+id/dividerHistory"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"
            android:background="#F5F5F5"
            app:layout_constraintTop_toBottomOf="@id/ivAvatarHistory" />

        <LinearLayout
            android:id="@+id/layoutInfoHistory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal"
            app:layout_constraintTop_toBottomOf="@id/dividerHistory">

            <TextView
                android:id="@+id/tvTimeHistory"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:drawableStart="@drawable/ic_clock"
                android:drawablePadding="8dp"
                android:alpha="0.6"
                android:text="20/10/2023"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvPriceHistory"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="250.000đ"
                android:textColor="#888888"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRebook"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Xem chi tiết"
            android:textAllCaps="false"
            android:textColor="#FF6D00"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/layoutInfoHistory" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>