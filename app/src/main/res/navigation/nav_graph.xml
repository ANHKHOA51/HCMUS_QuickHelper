<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/chat_list_fragment">

    <fragment
        android:id="@+id/login_fragment"
        android:name="com.example.hcmus_quickhelper.features.auth.ui.LoginFragment"
        tools:layout="@layout/fragment_login">
        <action
            android:id="@+id/action_login_to_register"
            app:destination="@id/register_fragment" />
    </fragment>

    <fragment
        android:id="@+id/register_fragment"
        android:name="com.example.hcmus_quickhelper.features.auth.ui.RegisterFragment"
        tools:layout="@layout/fragment_register">
        <action
            android:id="@+id/action_register_to_otp"
            app:destination="@id/otp_fragment" />
    </fragment>

    <fragment
        android:id="@+id/otp_fragment"
        android:name="com.example.hcmus_quickhelper.features.auth.ui.OTPFragment"
        tools:layout="@layout/fragment_otp">
        <argument
            android:name="email"
            app:argType="string" />
    </fragment>

    <fragment
        android:id="@+id/chat_list_fragment"
        android:name="com.example.hcmus_quickhelper.features.chat.ui.ChatListFragment"
        tools:layout="@layout/fragment_chat_list">

        <action
            android:id="@+id/action_chatList_to_chat"
            app:destination="@id/chat_fragment"
            tools:layout="@layout/fragment_chat" />
    </fragment>

    <fragment
        android:id="@+id/chat_fragment"
        android:name="com.example.hcmus_quickhelper.features.chat.ui.ChatFragment"
        tools:layout="@layout/fragment_chat" />

    <fragment
        android:id="@+id/community_fragment"
        android:name="com.example.hcmus_quickhelper.features.community.ui.CommunityFragment"
        tools:layout="@layout/fragment_feed">

        <action
            android:id="@+id/action_community_to_feedDetail"
            app:destination="@id/feed_detail_fragment"
            tools:layout="@layout/fragment_feed_detail" />
    </fragment>

    <fragment
        android:id="@+id/feed_detail_fragment"
        android:name="com.example.hcmus_quickhelper.features.community.ui.FeedDetailFragment"
        tools:layout="@layout/fragment_feed_detail">
    </fragment>
    <fragment
        android:id="@+id/payment_fragment"
        android:name="com.example.hcmus_quickhelper.features.payment.ui.PaymentFragment"
        android:label="fragment_payment"
        tools:layout="@layout/fragment_payment" >
        <action
            android:id="@+id/action_payment_fragment_to_voucher_fragment"
            app:destination="@id/voucher_fragment" />
        <action
            android:id="@+id/action_payment_fragment_to_receipt_fragment"
            app:destination="@id/receipt_fragment" />
    </fragment>
    <fragment
        android:id="@+id/voucher_fragment"
        android:name="com.example.hcmus_quickhelper.features.voucher.ui.VoucherFragment"
        android:label="fragment_voucher"
        tools:layout="@layout/fragment_voucher" />
    <fragment
        android:id="@+id/rating_fragment"
        android:name="com.example.hcmus_quickhelper.features.rating.ui.RatingFragment"
        android:label="fragment_rating"
        tools:layout="@layout/fragment_rating" />
    <fragment
        android:id="@+id/receipt_fragment"
        android:name="com.example.hcmus_quickhelper.features.receipt.ui.ReceiptFragment"
        android:label="fragment_payment"
        tools:layout="@layout/fragment_payment" >
        <action
            android:id="@+id/action_receipt_fragment_to_rating_fragment"
            app:destination="@id/rating_fragment" />
    </fragment>
</navigation>